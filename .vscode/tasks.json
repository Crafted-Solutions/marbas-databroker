{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Coverage report",
            "type": "shell",
            "command": "./scripts/TestReport.sh",
            "windows": {
                "command": ".\\scripts\\TestReport.cmd"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "revealProblems": "never",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Launch MarBasAPI",
            "type": "shell",
            "command": "dotnet run --project ${workspaceFolder}/src/MarBasAPI/MarBasAPI.csproj",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            },
            "presentation": {
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": ".",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "info:",
                    "endsPattern": "Content root path:"
                }
            }
        }
    ]
}